            {
              "value1": "={{ $node[\"Parse Message\"].json.operation }}",
              "value2": "search"
            }
          ]
        }
      },
      "id": "is-search",
      "name": "Is Search?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 450]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $node[\"Parse Message\"].json.operation }}",
              "value2": "delete"
            }
          ]
        }
      },
      "id": "is-delete",
      "name": "Is Delete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 600]
    },
    {
      "parameters": {
        "mode": "raw",
        "query": "=MATCH (u:User {telegram_id: $user_id})\nCREATE (n:Note {\n  id: randomUUID(),\n  text: $text,\n  improved_text: $improved_text,\n  created_at: datetime()\n})\nCREATE (u)-[:CREATED]->(n)\nWITH n\nUNWIND $tags AS tag_name\nMERGE (t:Tag {name: tag_name})\nCREATE (n)-[:TAGGED_WITH]->(t)\nRETURN n",
        "parameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $node[\"Parse Message\"].json.user_id }}"
            },
            {
              "name": "text",
              "value": "={{ $node[\"Parse Message\"].json.text }}"
            },
            {
              "name": "improved_text",
              "value": "={{ $node[\"Parse Message\"].json.improved_text }}"
            },
            {
              "name": "tags",
              "value": "={{ $node[\"Parse Message\"].json.tags }}"
            }
          ]
        }
      },
      "id": "save-operation",
      "name": "Save to Neo4j",
      "type": "n8n-nodes-base.neo4j",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "mode": "raw",
        "query": "=MATCH (u:User {telegram_id: $user_id})-[:CREATED]->(n)\nRETURN n\nORDER BY n.created_at DESC\nLIMIT 10",
        "parameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $node[\"Parse Message\"].json.user_id }}"
            }
          ]
        }
      },
      "id": "search-operation",
      "name": "Search in Neo4j",
      "type": "n8n-nodes-base.neo4j",
      "typeVersion": 1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "mode": "raw",
        "query": "=MATCH (u:User {telegram_id: $user_id})\nOPTIONAL MATCH (u)-[:CREATED]->(n:Note)\nOPTIONAL MATCH (u)-[:CREATED]->(t:Task)\nOPTIONAL MATCH (u)-[:CREATED]->(r:Reminder)\nRETURN\n  count(DISTINCT n) as notes_count,\n  count(DISTINCT t) as tasks_count,\n  count(DISTINCT r) as reminders_count",
        "parameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $node[\"Parse Message\"].json.user_id }}"
            }
          ]
        }
      },
      "id": "stats-operation",
      "name": "Get Stats",
      "type": "n8n-nodes-base.neo4j",
      "typeVersion": 1,
      "position": [1120, 600]
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst result = items[0].json;\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: `✅ Сохранено!\\n\\nID: ${result.n.id.substring(0, 8)}...`,\n  pending_id: messageData.pending_id\n};"
      },
      "id": "format-save-response",
      "name": "Format Save Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst results = items;\n\nif (results.length === 0) {\n  return {\n    chat_id: messageData.chat_id,\n    text: '🔍 Ничего не найдено'\n  };\n}\n\nlet text = `🔍 Найдено: ${results.length}\\n\\n`;\n\nresults.forEach((item, index) => {\n  const n = item.json.n;\n  text += `${index + 1}. ${n.improved_text || n.text}\\n`;\n  text += `   ID: ${n.id.substring(0, 8)}...\\n\\n`;\n});\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: text\n};"
      },
      "id": "format-search-response",
      "name": "Format Search Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst stats = items[0].json;\n\nconst text = `📊 Статистика:\\n\\n` +\n  `📝 Заметок: ${stats.notes_count}\\n` +\n  `✅ Задач: ${stats.tasks_count}\\n` +\n  `⏰ Напоминаний: ${stats.reminders_count}`;\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: text\n};"
      },
      "id": "format-stats-response",
      "name": "Format Stats Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"chat_id\": $json.chat_id, \"text\": $json.text } }}",
        "options": {}
      },
