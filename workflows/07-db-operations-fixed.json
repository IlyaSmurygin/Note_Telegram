      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "mode": "raw",
        "query": "=MERGE (u:User {telegram_id: $user_id})\nON CREATE SET u.created_at = datetime()\nRETURN u",
        "parameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            }
          ]
        }
      },
      "id": "ensure-user-exists",
      "name": "Ensure User Exists",
