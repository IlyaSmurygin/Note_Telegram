    {
      "parameters": {
        "method": "POST",
        "url": "http://neo4j:7474/db/neo4j/tx/commit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"statements\": [{\n    \"statement\": \"MATCH (u:User {telegram_id: $user_id}) CREATE (n:Note { id: randomUUID(), text: $text, improved_text: $improved_text, created_at: datetime() }) CREATE (u)-[:CREATED]->(n) WITH n UNWIND $tags AS tag_name MERGE (t:Tag {name: tag_name}) CREATE (n)-[:TAGGED_WITH]->(t) RETURN n\",\n    \"parameters\": {\n      \"user_id\": $node[\"Parse Message\"].json.user_id,\n      \"text\": $node[\"Parse Message\"].json.text,\n      \"improved_text\": $node[\"Parse Message\"].json.improved_text,\n      \"tags\": $node[\"Parse Message\"].json.tags || []\n    }\n  }]\n} }}",
        "options": {}
      },
      "id": "save-neo4j",
      "name": "Save to Neo4j",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 150],
      "credentials": {
        "httpBasicAuth": {
          "id": "5",
          "name": "Neo4j Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://neo4j:7474/db/neo4j/tx/commit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"statements\": [{\n    \"statement\": \"MATCH (u:User {telegram_id: $user_id})-[:CREATED]->(n) RETURN n ORDER BY n.created_at DESC LIMIT 10\",\n    \"parameters\": {\n      \"user_id\": $node[\"Parse Message\"].json.user_id\n    }\n  }]\n} }}",
        "options": {}
      },
      "id": "search-neo4j",
      "name": "Search in Neo4j",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 350],
      "credentials": {
        "httpBasicAuth": {
          "id": "5",
          "name": "Neo4j Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://neo4j:7474/db/neo4j/tx/commit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"statements\": [{\n    \"statement\": \"MATCH (u:User {telegram_id: $user_id}) OPTIONAL MATCH (u)-[:CREATED]->(n:Note) OPTIONAL MATCH (u)-[:CREATED]->(t:Task) OPTIONAL MATCH (u)-[:CREATED]->(r:Reminder) RETURN count(DISTINCT n) as notes_count, count(DISTINCT t) as tasks_count, count(DISTINCT r) as reminders_count\",\n    \"parameters\": {\n      \"user_id\": $node[\"Parse Message\"].json.user_id\n    }\n  }]\n} }}",
        "options": {}
      },
      "id": "stats-neo4j",
      "name": "Get Stats from Neo4j",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 550],
      "credentials": {
        "httpBasicAuth": {
          "id": "5",
          "name": "Neo4j Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst neo4jResult = $json.results[0];\n\nif (!neo4jResult || !neo4jResult.data || neo4jResult.data.length === 0) {\n  return {\n    chat_id: messageData.chat_id,\n    text: '❌ Ошибка сохранения'\n  };\n}\n\nconst nodeData = neo4jResult.data[0].row[0];\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: `✅ Сохранено!\\n\\nID: ${nodeData.id.substring(0, 8)}...`,\n  pending_id: messageData.pending_id\n};"
      },
      "id": "format-save",
      "name": "Format Save Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 150]
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst neo4jResult = $json.results[0];\n\nif (!neo4jResult || !neo4jResult.data || neo4jResult.data.length === 0) {\n  return {\n    chat_id: messageData.chat_id,\n    text: '🔍 Ничего не найдено'\n  };\n}\n\nlet text = `🔍 Найдено: ${neo4jResult.data.length}\\n\\n`;\n\nneo4jResult.data.forEach((item, index) => {\n  const n = item.row[0];\n  text += `${index + 1}. ${n.improved_text || n.text}\\n`;\n  text += `   ID: ${n.id.substring(0, 8)}...\\n\\n`;\n});\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: text\n};"
      },
      "id": "format-search",
      "name": "Format Search Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 350]
    },
    {
      "parameters": {
        "jsCode": "const messageData = $node[\"Parse Message\"].json;\nconst neo4jResult = $json.results[0];\n\nif (!neo4jResult || !neo4jResult.data || neo4jResult.data.length === 0) {\n  return {\n    chat_id: messageData.chat_id,\n    text: '❌ Ошибка получения статистики'\n  };\n}\n\nconst stats = neo4jResult.data[0].row[0];\n\nconst text = `📊 Статистика:\\n\\n` +\n  `📝 Заметок: ${stats.notes_count || 0}\\n` +\n  `✅ Задач: ${stats.tasks_count || 0}\\n` +\n  `⏰ Напоминаний: ${stats.reminders_count || 0}`;\n\nreturn {\n  chat_id: messageData.chat_id,\n  text: text\n};"
      },
      "id": "format-stats",
      "name": "Format Stats Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 550]
    },
